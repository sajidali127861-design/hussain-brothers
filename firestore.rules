rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = only this email. Use exactly the same email as admin.emails in config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['owner@example.com'];
    }

    // Customers can only read visible products and categories. Only the admin can write.
    match /products/{id} {
      allow read: if resource.data.isVisible == true || isAdmin();
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if resource.data.isVisible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Settings (weights, shop details): anyone can read, only the admin can write.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customers can only create them (not read). Only the admin can read or change them.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','address','note','items','total','orderNo','status','createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.total is number && request.resource.data.total > 0;
      allow read, update, delete: if isAdmin();
    }
  }
}
